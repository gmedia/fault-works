				"label": "Load balancer",
				"config": {
					"algorithm": "round-robin",
					"retries": 0,
					"healthCheck": {
						"enabled": true,
						"intervalMs": 5000,
						"probeTimeoutMs": 1000,
						"unhealthyThreshold": 2,
						"healthyThreshold": 2
					}
				}
			},
			{
				"id": "server-a",
				"kind": "service",
				"label": "Server A",
				"config": {
					"capacity": 8,
					"queueCapacity": 20,
					"serviceTimeMs": 80,
					"serviceTimeDistribution": "exponential"
				}
			},
			{
				"id": "server-b",
				"kind": "service",
				"label": "Server B",
				"config": {
					"capacity": 8,
