	"workload": {
		"arrival": "poisson",
		"offeredRps": 150,
		"startMs": 0,
		"durationMs": 60000,
		"timeoutMs": 1000,
		"bursts": [
			{
				"atMs": 30000,
				"durationMs": 10000,
