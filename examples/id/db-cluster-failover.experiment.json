	"workload": {
		"arrival": "constant",
		"offeredRps": 500,
		"startMs": 0,
		"durationMs": 60000,
		"timeoutMs": 1000,
		"propagateDeadline": false,
		"bursts": []
	},
	"faults": [
		{
			"id": "primary-crash",
			"target": "primary",
			"atMs": 20000,
			"kind": "node-failure",
			"recoverAtMs": null,
			"behavior": "refuse"
		}
	],
	"run": {
		"sampleWindowMs": 1000
	},
	"assumptions": [
		"Model abstrak di tingkat request: tidak ada TCP, TLS, paket, atau semantik proxy HTTP sungguhan.",
		"Setiap komponen punya slot konkurensi tetap dan antrean FIFO; tidak ada model CPU, memori, atau GC.",
		"Komponen tidak tahu kalau pemanggilnya sudah menyerah, kecuali propagasi deadline dinyalakan.",
		"Angka-angka di sini adalah masukan skenario, bukan pengukuran performa produk mana pun.",
		"Replikasi dianggap seketika; tidak ada lag atau data yang hilang saat promosi."
	],
	"expectedObservations": [
		"Selama 15 detik semua tulis gagal karena masih dikirim ke primary yang mati; baca tetap lancar.",
		"Setelah promosi, Replika 1 menerima semua tulis dan Replika 2 menanggung semua baca sendirian."
	],
