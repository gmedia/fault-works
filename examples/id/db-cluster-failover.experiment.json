				}
			},
			{
				"id": "pg-cluster-replica-1",
				"source": "pg-cluster",
				"target": "replica-1",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
					"failureThreshold": 5,
					"openMs": 10000
