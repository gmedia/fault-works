{
	"schemaVersion": "0.3.0",
	"experimentId": "db-cluster-failover",
	"title": "Failover cluster database",
	"question": "Saat primary mati, berapa lama tulis gagal dan apakah baca ikut terganggu?",
	"description": "API memanggil cluster PostgreSQL berisi satu primary dan dua replika. 20% panggilan adalah tulis dan dikirim ke primary; baca dibagi ke replika. Primary mati di detik 20. Sistem failover (misalnya Patroni) butuh 15 detik untuk sadar dan mempromosikan replika.",
	"seed": 42,
	"model": {
		"nodes": [
			{
				"id": "client",
				"kind": "client",
				"label": "Klien"
			},
			{
				"id": "api",
				"kind": "service",
				"label": "API",
				"config": {
					"capacity": 100,
					"queueCapacity": 200,
					"serviceTimeMs": 5,
					"serviceTimeDistribution": "fixed",
					"contention": 0,
					"coherency": 0,
					"queueTimeoutMs": null,
					"callMode": "sequential"
				}
			},
			{
				"id": "pg-cluster",
				"kind": "db-cluster",
				"label": "Cluster PostgreSQL",
				"config": {
					"writeRatio": 0.2,
					"failoverMs": 15000
				}
			},
			{
				"id": "primary",
				"kind": "database",
				"label": "Primary",
				"config": {
					"capacity": 100,
					"queueCapacity": 0,
					"serviceTimeMs": 4,
					"serviceTimeDistribution": "exponential",
					"contention": 0.02,
					"coherency": 0.0005,
					"queueTimeoutMs": null,
					"callMode": "sequential"
				}
			},
			{
				"id": "replica-1",
				"kind": "database",
				"label": "Replika 1",
				"config": {
					"capacity": 100,
					"queueCapacity": 0,
					"serviceTimeMs": 4,
					"serviceTimeDistribution": "exponential",
					"contention": 0.02,
					"coherency": 0.0005,
					"queueTimeoutMs": null,
					"callMode": "sequential"
				}
			},
			{
				"id": "replica-2",
				"kind": "database",
				"label": "Replika 2",
				"config": {
					"capacity": 100,
					"queueCapacity": 0,
					"serviceTimeMs": 4,
					"serviceTimeDistribution": "exponential",
					"contention": 0.02,
					"coherency": 0.0005,
					"queueTimeoutMs": null,
					"callMode": "sequential"
				}
			}
		],
		"links": [
			{
