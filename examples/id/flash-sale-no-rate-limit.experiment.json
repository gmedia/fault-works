{
	"schemaVersion": "0.3.0",
	"experimentId": "flash-sale-no-rate-limit",
	"title": "Flash sale tanpa rate limit",
	"question": "Apa yang dialami semua pembeli saat flash sale mengirim trafik enam kali lipat?",
	"description": "Toko daring biasa menerima 300 request per detik. Saat flash sale di detik 20 sampai 35, trafik naik ke 1.800 request per detik. Dua server toko memanggil database PostgreSQL.",
	"seed": 42,
	"model": {
		"nodes": [
			{
				"id": "client",
				"kind": "client",
				"label": "Pembeli"
			},
			{
				"id": "lb",
				"kind": "load-balancer",
				"label": "Load balancer",
				"config": {
					"algorithm": "round-robin",
					"retries": 0,
					"healthCheck": {
						"enabled": true,
						"intervalMs": 5000,
						"probeTimeoutMs": 1000,
						"unhealthyThreshold": 2,
						"healthyThreshold": 2
					}
				}
			},
			{
				"id": "shop-a",
				"kind": "service",
				"label": "Toko A",
				"preset": "web-server",
				"config": {
					"capacity": 32,
					"queueCapacity": 500,
					"serviceTimeMs": 40,
					"serviceTimeDistribution": "exponential",
					"contention": 0,
					"coherency": 0,
					"queueTimeoutMs": null,
					"callMode": "sequential"
				}
			},
			{
				"id": "shop-b",
				"kind": "service",
				"label": "Toko B",
				"preset": "web-server",
				"config": {
					"capacity": 32,
					"queueCapacity": 500,
					"serviceTimeMs": 40,
					"serviceTimeDistribution": "exponential",
					"contention": 0,
					"coherency": 0,
					"queueTimeoutMs": null,
					"callMode": "sequential"
				}
			},
			{
				"id": "db",
				"kind": "database",
				"label": "PostgreSQL",
				"config": {
					"capacity": 100,
					"queueCapacity": 0,
					"serviceTimeMs": 5,
					"serviceTimeDistribution": "exponential",
					"contention": 0.02,
					"coherency": 0.0005,
					"queueTimeoutMs": null,
					"callMode": "sequential"
				}
			}
		],
		"links": [
			{
				"id": "client-lb",
				"source": "client",
				"target": "lb",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
					"failureThreshold": 5,
					"openMs": 10000
				}
			},
			{
				"id": "lb-shop-a",
				"source": "lb",
				"target": "shop-a",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
					"failureThreshold": 5,
					"openMs": 10000
				}
			},
			{
				"id": "lb-shop-b",
				"source": "lb",
				"target": "shop-b",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
					"failureThreshold": 5,
					"openMs": 10000
				}
			},
			{
				"id": "shop-a-db",
				"source": "shop-a",
				"target": "db",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
					"failureThreshold": 5,
					"openMs": 10000
				}
			},
			{
				"id": "shop-b-db",
				"source": "shop-b",
				"target": "db",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
					"failureThreshold": 5,
					"openMs": 10000
				}
			}
		]
	},
	"workload": {
		"arrival": "constant",
		"offeredRps": 300,
		"startMs": 0,
		"durationMs": 60000,
		"timeoutMs": 3000,
		"propagateDeadline": false,
		"bursts": [
			{
				"atMs": 20000,
				"durationMs": 15000,
				"extraRps": 1500
			}
		]
	},
	"faults": [],
	"run": {
		"sampleWindowMs": 1000
	},
	"assumptions": [
		"Model abstrak di tingkat request: tidak ada TCP, TLS, paket, atau semantik proxy HTTP sungguhan.",
		"Setiap komponen punya slot konkurensi tetap dan antrean FIFO; tidak ada model CPU, memori, atau GC.",
		"Komponen tidak tahu kalau pemanggilnya sudah menyerah, kecuali propagasi deadline dinyalakan.",
		"Angka-angka di sini adalah masukan skenario, bukan pengukuran performa produk mana pun."
	],
	"expectedObservations": [
		"Server toko kewalahan; antreannya memanjang sehingga hampir semua pembeli menunggu lama atau gagal."
	],
	"layout": {
		"client": {
			"x": 0,
			"y": 0
		},
		"lb": {
			"x": 300,
			"y": 0
		},
		"shop-a": {
			"x": 600,
			"y": -90
		},
		"shop-b": {
			"x": 600,
			"y": 90
		},
		"db": {
			"x": 900,
			"y": 0
		}
	}
}
