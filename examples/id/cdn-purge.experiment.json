					"openMs": 10000
				}
			},
			{
				"id": "lb-web-a",
				"source": "lb",
				"target": "web-a",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
					"failureThreshold": 5,
					"openMs": 10000
				}
			},
			{
				"id": "lb-web-b",
				"source": "lb",
				"target": "web-b",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
					"failureThreshold": 5,
					"openMs": 10000
				}
			},
			{
				"id": "web-a-db",
				"source": "web-a",
				"target": "db",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
					"failureThreshold": 5,
					"openMs": 10000
				}
			},
			{
				"id": "web-b-db",
				"source": "web-b",
				"target": "db",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
					"failureThreshold": 5,
					"openMs": 10000
				}
			}
		]
	},
	"workload": {
		"arrival": "constant",
		"offeredRps": 3000,
		"startMs": 0,
		"durationMs": 60000,
		"timeoutMs": 1000,
		"propagateDeadline": false,
		"bursts": []
	},
	"faults": [
		{
			"id": "cdn-purge",
			"target": "cdn",
			"atMs": 20000,
			"kind": "cache-flush",
			"untilMs": 25000
		}
	],
	"run": {
		"sampleWindowMs": 1000
	},
	"assumptions": [
		"Model abstrak di tingkat request: tidak ada TCP, TLS, paket, atau semantik proxy HTTP sungguhan.",
		"Setiap komponen punya slot konkurensi tetap dan antrean FIFO; tidak ada model CPU, memori, atau GC.",
		"Komponen tidak tahu kalau pemanggilnya sudah menyerah, kecuali propagasi deadline dinyalakan.",
		"Angka-angka di sini adalah masukan skenario, bukan pengukuran performa produk mana pun."
	],
	"expectedObservations": [
		"Selama purge, trafik ke server asal naik sepuluh kali lipat dan melebihi kapasitas web server.",
		"Antrean web server penuh dan banyak request ditolak, lalu semuanya normal lagi saat cache terisi."
	],
	"layout": {
