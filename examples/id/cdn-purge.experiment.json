{
	"schemaVersion": "0.3.0",
	"experimentId": "cdn-purge",
	"title": "CDN di-purge saat ramai",
	"question": "Apa yang terjadi pada server asal saat seluruh cache CDN dikosongkan di tengah trafik ramai?",
	"description": "3.000 request per detik masuk lewat CDN yang biasanya menjawab 90% dari cache. Hanya 10% yang sampai ke dua web server dan database. Di detik 20 seseorang mem-purge cache CDN selama 5 detik.",
	"seed": 42,
	"model": {
		"nodes": [
			{
				"id": "client",
				"kind": "client",
				"label": "Klien"
			},
			{
				"id": "cdn",
				"kind": "cache",
				"label": "CDN",
				"preset": "cdn",
				"config": {
					"capacity": 2000,
					"queueCapacity": 0,
					"serviceTimeMs": 2,
					"serviceTimeDistribution": "fixed",
					"contention": 0,
					"coherency": 0,
					"queueTimeoutMs": null,
					"callMode": "sequential",
					"hitRatio": 0.9
				}
			},
			{
				"id": "lb",
				"kind": "load-balancer",
				"label": "Load balancer",
				"config": {
					"algorithm": "round-robin",
					"retries": 0,
					"healthCheck": {
						"enabled": true,
						"intervalMs": 5000,
						"probeTimeoutMs": 1000,
						"unhealthyThreshold": 2,
						"healthyThreshold": 2
					}
				}
			},
			{
				"id": "web-a",
				"kind": "service",
				"label": "Web server A",
				"preset": "web-server",
				"config": {
					"capacity": 32,
					"queueCapacity": 128,
					"serviceTimeMs": 30,
					"serviceTimeDistribution": "exponential",
					"contention": 0,
					"coherency": 0,
					"queueTimeoutMs": null,
					"callMode": "sequential"
				}
			},
			{
				"id": "web-b",
				"kind": "service",
				"label": "Web server B",
				"preset": "web-server",
				"config": {
					"capacity": 32,
					"queueCapacity": 128,
					"serviceTimeMs": 30,
					"serviceTimeDistribution": "exponential",
					"contention": 0,
					"coherency": 0,
					"queueTimeoutMs": null,
					"callMode": "sequential"
				}
			},
			{
				"id": "db",
				"kind": "database",
				"label": "PostgreSQL",
				"config": {
					"capacity": 100,
					"queueCapacity": 0,
					"serviceTimeMs": 5,
					"serviceTimeDistribution": "exponential",
					"contention": 0.02,
					"coherency": 0.0005,
					"queueTimeoutMs": null,
					"callMode": "sequential"
				}
			}
		],
		"links": [
			{
				"id": "client-cdn",
				"source": "client",
				"target": "cdn",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
					"failureThreshold": 5,
					"openMs": 10000
				}
			},
			{
				"id": "cdn-lb",
				"source": "cdn",
				"target": "lb",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
