{
	"schemaVersion": "0.3.0",
	"experimentId": "flash-sale-with-rate-limit",
	"title": "Flash sale with a rate limit",
	"question": "If an API gateway caps traffic at 1,200 requests per second, are the shoppers who get in still served quickly?",
	"description": "Same as the flash sale without a rate limit, but an API gateway in front of the shop uses a token bucket of 1,200 requests per second with a burst of 200, below what the two shop servers can handle. Excess traffic is rejected at once with 429.",
	"seed": 42,
	"model": {
		"nodes": [
			{
				"id": "client",
				"kind": "client",
				"label": "Shoppers"
			},
			{
				"id": "gateway",
				"kind": "rate-limiter",
				"label": "API gateway",
				"preset": "api-gateway",
				"config": {
					"ratePerSec": 1200,
					"burst": 200
				}
			},
			{
				"id": "lb",
				"kind": "load-balancer",
				"label": "Load balancer",
				"config": {
					"algorithm": "round-robin",
					"retries": 0,
					"healthCheck": {
						"enabled": true,
						"intervalMs": 5000,
						"probeTimeoutMs": 1000,
						"unhealthyThreshold": 2,
						"healthyThreshold": 2
					}
				}
			},
			{
				"id": "shop-a",
				"kind": "service",
				"label": "Shop A",
				"preset": "web-server",
				"config": {
					"capacity": 32,
					"queueCapacity": 500,
					"serviceTimeMs": 40,
					"serviceTimeDistribution": "exponential",
					"contention": 0,
					"coherency": 0,
					"queueTimeoutMs": null,
					"callMode": "sequential"
				}
			},
			{
				"id": "shop-b",
				"kind": "service",
				"label": "Shop B",
				"preset": "web-server",
				"config": {
					"capacity": 32,
					"queueCapacity": 500,
					"serviceTimeMs": 40,
					"serviceTimeDistribution": "exponential",
					"contention": 0,
					"coherency": 0,
					"queueTimeoutMs": null,
					"callMode": "sequential"
				}
			},
			{
				"id": "db",
				"kind": "database",
				"label": "PostgreSQL",
				"config": {
					"capacity": 100,
					"queueCapacity": 0,
					"serviceTimeMs": 5,
					"serviceTimeDistribution": "exponential",
					"contention": 0.02,
					"coherency": 0.0005,
					"queueTimeoutMs": null,
					"callMode": "sequential"
				}
			}
		],
		"links": [
			{
				"id": "client-gateway",
				"source": "client",
				"target": "gateway",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
					"failureThreshold": 5,
					"openMs": 10000
				}
			},
			{
				"id": "gateway-lb",
				"source": "gateway",
				"target": "lb",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
					"failureThreshold": 5,
					"openMs": 10000
				}
			},
			{
				"id": "lb-shop-a",
				"source": "lb",
