			},
			{
				"id": "shop-b-db",
				"source": "shop-b",
				"target": "db",
				"latencyMs": 0,
				"timeoutMs": null,
				"retries": 0,
				"retryBackoffMs": 0,
				"retryJitter": false,
				"retryBudget": null,
				"circuitBreaker": {
					"enabled": false,
					"failureThreshold": 5,
					"openMs": 10000
				}
			}
		]
	},
	"workload": {
		"arrival": "constant",
		"offeredRps": 300,
		"startMs": 0,
		"durationMs": 60000,
		"timeoutMs": 3000,
		"propagateDeadline": false,
		"bursts": [
			{
				"atMs": 20000,
				"durationMs": 15000,
				"extraRps": 1500
			}
		]
	},
	"faults": [],
	"run": {
		"sampleWindowMs": 1000
	},
	"assumptions": [
		"Abstract request-level model: no TCP, TLS, packets or real HTTP proxy semantics.",
		"Each component has fixed concurrency slots and a FIFO queue; there is no CPU, memory or GC model.",
		"Components do not know when their caller gave up, unless deadline propagation is on.",
		"Numbers are scenario inputs, not measured performance of any product."
	],
	"expectedObservations": [
		"Some shoppers are turned away at once, but those who get in are served with normal latency."
	],
	"layout": {
